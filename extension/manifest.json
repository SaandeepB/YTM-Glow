{
  "manifest_version": 3,
  "name": "YTM Glow Bridge",
  "short_name": "YTM Glow",
  "version": "0.1.0",
  "description": "Shares what YouTube Music is playing (track, position, beat levels) with the YTM Glow app on this Mac. Connects only to 127.0.0.1.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "action": {
    "default_title": "YTM Glow Bridge",
    "default_popup": "popup.html"
  }
}
